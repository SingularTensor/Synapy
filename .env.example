APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-local-dev-secret

DATABASE_URL=sqlite:///synapy.db

# Billing provider: dev or stripe
BILLING_PROVIDER=dev
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
BILLING_ALERTS_ENABLED=false
BILLING_ALERT_WEBHOOK_URL=
BILLING_ALERT_TIMEOUT_SECONDS=3

# Security/session
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
WTF_CSRF_SSL_STRICT=false
WTF_CSRF_TIME_LIMIT_SECONDS=3600
SESSION_LIFETIME_MINUTES=10080

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=200 per minute
RATE_LIMIT_REGISTER=100 per minute
RATE_LIMIT_ADMIN_MUTATIONS=300 per minute
RATE_LIMIT_UPGRADE_CHECKOUT=100 per minute
RATE_LIMIT_SESSION_START=1000 per minute
RATE_LIMIT_SESSION_END=1000 per minute
RATE_LIMIT_TIMEZONE_SYNC=300 per minute
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_STRATEGY=fixed-window

# Optional fallback timezone for streak rollover when user timezone is unavailable
STREAK_TIMEZONE=UTC
